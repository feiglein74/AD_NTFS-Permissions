<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>NtfsPermissions.Item</Name>
      <ViewSelectedBy>
        <TypeName>NtfsPermissions.Item</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Pfad</Label></TableColumnHeader>
          <TableColumnHeader><Label>Besitzer</Label></TableColumnHeader>
          <TableColumnHeader><Label>Vererbung</Label></TableColumnHeader>
          <TableColumnHeader><Label>ACEs</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Explizit</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Hinweis</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Owner</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.Error) { '-' } elseif ($_.InheritanceEnabled) { 'aktiv' } else { 'DEAKTIVIERT' }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>AceCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExplicitCount</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>(@($_.Error, $_.Note) | Where-Object { $_ }) -join ' | '</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>NtfsPermissions.Ace</Name>
      <ViewSelectedBy>
        <TypeName>NtfsPermissions.Ace</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Typ</Label></TableColumnHeader>
          <TableColumnHeader><Label>Konto</Label></TableColumnHeader>
          <TableColumnHeader><Label>Kontotyp</Label></TableColumnHeader>
          <TableColumnHeader><Label>Rechte</Label></TableColumnHeader>
          <TableColumnHeader><Label>Gilt für</Label></TableColumnHeader>
          <TableColumnHeader><Label>Geerbt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Principal</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AccountType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Rights</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AppliesTo</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Inherited</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
